<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#F5F7FB"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:layout_marginBottom="8dp"
        android:background="#FFFFFF"
        android:gravity="end|center_vertical"
        android:layoutDirection="ltr"
        android:textDirection="ltr"
        android:maxLines="1"
        android:padding="20dp"
        android:text="0"
        android:textColor="#172033"
        android:textSize="48sp"
        android:textStyle="bold"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="18sp"
        android:autoSizeMaxTextSize="48sp" />

    <LinearLayout
        android:id="@+id/keypad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:layoutDirection="ltr"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button
                style="@style/OpKey"
                android:layout_weight="2"
                android:tag="C"
                android:text="C" />
            <Button
                style="@style/OpKey"
                android:layout_weight="2"
                android:tag="B"
                android:text="⌫" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button
                style="@style/KeyButton"
                android:tag="7"
                android:text="7" />
            <Button
                style="@style/KeyButton"
                android:tag="8"
                android:text="8" />
            <Button
                style="@style/KeyButton"
                android:tag="9"
                android:text="9" />
            <Button
                style="@style/OpKey"
                android:tag="/"
                android:text="÷" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button
                style="@style/KeyButton"
                android:tag="4"
                android:text="4" />
            <Button
                style="@style/KeyButton"
                android:tag="5"
                android:text="5" />
            <Button
                style="@style/KeyButton"
                android:tag="6"
                android:text="6" />
            <Button
                style="@style/OpKey"
                android:tag="*"
                android:text="×" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button
                style="@style/KeyButton"
                android:tag="1"
                android:text="1" />
            <Button
                style="@style/KeyButton"
                android:tag="2"
                android:text="2" />
            <Button
                style="@style/KeyButton"
                android:tag="3"
                android:text="3" />
            <Button
                style="@style/OpKey"
                android:tag="-"
                android:text="−" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button
                style="@style/KeyButton"
                android:tag="0"
                android:text="0" />
            <Button
                style="@style/KeyButton"
                android:tag="."
                android:text="." />
            <Button
                style="@style/EqualsKey"
                android:tag="="
                android:text="=" />
            <Button
                style="@style/OpKey"
                android:tag="+"
                android:text="+" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
